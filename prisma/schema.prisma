generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String              @id @default(cuid())
  firstName             String
  middleName            String?
  lastName              String
  email                 String?             @unique
  phone                 String              @unique
  passwordHash          String
  role                  UserRole            @default(STUDENT)
  status                UserStatus          @default(ACTIVE)
  grade                 String?
  avatarUrl             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  answers               AssessmentAnswer[]
  attempts              AssessmentAttempt[]
  notifications         Notification[]
  subscriptions         Subscription[]
  subscriptionCodesUsed SubscriptionCode[]  @relation("SubscriptionCodeUsedBy")
  supportTickets        SupportTicket[]
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  grade       String?
  subject     String   @default("اللغة العربية")
  imageUrl    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  units       Unit[]
}

model Unit {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  exams       Exam[]
  lessons     Lesson[]
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Lesson {
  id          String       @id @default(cuid())
  unitId      String
  title       String
  description String?
  videoUrl    String?
  duration    Int?
  order       Int          @default(0)
  isPublished Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignments Assignment[]
  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  files       LessonFile[]
}

model LessonFile {
  id        String   @id @default(cuid())
  lessonId  String
  name      String
  url       String
  type      String?
  createdAt DateTime @default(now())
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Assignment {
  id          String               @id @default(cuid())
  lessonId    String?
  title       String
  description String?
  totalPoints Int                  @default(0)
  deadline    DateTime?
  isPublished Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  attempts    AssessmentAttempt[]
  lesson      Lesson?              @relation(fields: [lessonId], references: [id])
  questions   AssignmentQuestion[]
}

model Exam {
  id          String              @id @default(cuid())
  unitId      String?
  title       String
  description String?
  totalPoints Int                 @default(0)
  duration    Int?
  startsAt    DateTime?
  endsAt      DateTime?
  isPublished Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  attempts    AssessmentAttempt[]
  unit        Unit?               @relation(fields: [unitId], references: [id])
  questions   ExamQuestion[]
}

model AssignmentQuestion {
  id            String     @id @default(cuid())
  assignmentId  String
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  points        Int        @default(1)
  order         Int        @default(0)
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model ExamQuestion {
  id            String @id @default(cuid())
  examId        String
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  points        Int    @default(1)
  order         Int    @default(0)
  exam          Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model AssessmentAttempt {
  id           String             @id @default(cuid())
  userId       String
  assignmentId String?
  examId       String?
  type         AssessmentType
  score        Int                @default(0)
  totalPoints  Int                @default(0)
  percentage   Float              @default(0)
  startedAt    DateTime           @default(now())
  submittedAt  DateTime?
  createdAt    DateTime           @default(now())
  answers      AssessmentAnswer[]
  assignment   Assignment?        @relation(fields: [assignmentId], references: [id])
  exam         Exam?              @relation(fields: [examId], references: [id])
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AssessmentAnswer {
  id         String            @id @default(cuid())
  attemptId  String
  userId     String
  questionId String
  answer     String?
  isCorrect  Boolean           @default(false)
  points     Int               @default(0)
  createdAt  DateTime          @default(now())
  attempt    AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id           String             @id @default(cuid())
  userId       String
  plan         SubscriptionPlan
  status       SubscriptionStatus @default(ACTIVE)
  amount       Decimal            @db.Decimal(10, 2)
  startsAt     DateTime           @default(now())
  expiresAt    DateTime
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  sourceCodeId String             @unique
  sourceCode   SubscriptionCode   @relation(fields: [sourceCodeId], references: [id])
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
}

model SubscriptionCode {
  id            String           @id @default(cuid())
  code          String           @unique
  plan          SubscriptionPlan
  price         Decimal          @db.Decimal(10, 2)
  durationDays  Int
  isUsed        Boolean          @default(false)
  isActive      Boolean          @default(true)
  usedByUserId  String?
  usedAt        DateTime?
  codeExpiresAt DateTime?
  createdAt     DateTime         @default(now())
  subscription  Subscription?
  usedByUser    User?            @relation("SubscriptionCodeUsedBy", fields: [usedByUserId], references: [id])

  @@index([usedByUserId])
  @@index([isUsed, isActive])
}

model SubscriptionPlanConfig {
  id           String           @id @default(cuid())
  plan         SubscriptionPlan @unique
  name         String
  price        Decimal          @db.Decimal(10, 2)
  durationDays Int
  isActive     Boolean          @default(true)
  updatedAt    DateTime         @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id        String        @id @default(cuid())
  userId    String
  subject   String
  category  String
  message   String
  status    SupportStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  STUDENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AssessmentType {
  ASSIGNMENT
  EXAM
}

enum SubscriptionPlan {
  MONTHLY
  TERM
  ANNUAL
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum NotificationType {
  LESSON
  ASSIGNMENT
  EXAM
  RESULT
  SYSTEM
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
